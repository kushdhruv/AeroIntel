# Local operation requires no credentials. Keep this home directory on a local disk.
AEROINTEL_HOME=data/platform
DO_NOT_TRACK=1
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_DISABLE_AGENT_HINT=1
# Optional: path to validated YAML; environment variables are loaded by the shell,
# not automatically from this example file.
# AEROINTEL_CONFIG=configs/local.yaml
# AEROINTEL_IDENTITIES is a JSON map from SHA256(token) to server-owned identity.
# Generate it locally using: uv run --no-sync python tools/create_identity.py operator
# AEROINTEL_TOKEN is for CLI writes; AEROINTEL_MCP_TOKEN grants a stdio operator.
# Never put real tokens in this tracked example.
# AWS_PROFILE=aerointel-sso
# AWS_DEFAULT_REGION=ap-south-1
# No AWS variables are necessary for tests, local demo, or local inference.
