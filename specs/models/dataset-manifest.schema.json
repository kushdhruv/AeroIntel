{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerointel:dataset-manifest:1.0.0",
  "title": "dataset-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "source",
    "usage_terms",
    "split_policy",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "usage_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "prohibited"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "split_policy": {
      "enum": [
        "random",
        "scene_group_holdout",
        "spatial_block_holdout"
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "source_scene_id",
          "image_pair",
          "mask",
          "metadata",
          "checksum"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "source_scene_id": {
            "type": "string",
            "minLength": 1
          },
          "image_pair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after"
            ],
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "mask": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region_id",
              "crs",
              "bounds",
              "acquisition_before",
              "acquisition_after"
            ],
            "properties": {
              "region_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "crs": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^EPSG:[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bounds": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acquisition_before": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acquisition_after": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": {
                  "crs": {
                    "type": "null"
                  },
                  "bounds": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "crs": {
                    "type": "string"
                  },
                  "bounds": {
                    "type": "array"
                  }
                }
              }
            ]
          },
          "checksum": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after",
              "mask"
            ],
            "properties": {
              "before": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "after": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "mask": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
