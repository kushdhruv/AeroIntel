{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerointel:drift-report:1.0.0",
  "title": "drift-report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "model_id",
    "model_version",
    "created_at",
    "reference_dataset_version",
    "window_start",
    "window_end",
    "input_shift",
    "regional_prediction_shift",
    "performance",
    "evidently_report_uri",
    "investigation_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference_dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "input_shift": {
      "enum": [
        "detected",
        "not_detected",
        "insufficient_data"
      ]
    },
    "regional_prediction_shift": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "status"
        ],
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "detected",
              "not_detected",
              "insufficient_data"
            ]
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label_count",
        "iou",
        "f1"
      ],
      "properties": {
        "status": {
          "enum": [
            "degraded",
            "stable",
            "missing_labels",
            "insufficient_data"
          ]
        },
        "label_count": {
          "type": "integer",
          "minimum": 0
        },
        "iou": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "f1": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidently_report_uri": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "investigation_required": {
      "type": "boolean"
    }
  }
}
