{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerointel:model-manifest:1.0.0",
  "title": "model-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "model_version",
    "architecture",
    "dataset_id",
    "dataset_version",
    "artifact_uri",
    "artifact_sha256",
    "evaluation_id",
    "created_at",
    "state",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "const": "siamese_unet"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_uri": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "pending_approval",
        "approved",
        "deployed",
        "retired"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_id",
            "actor_id",
            "approved_at",
            "artifact_sha256",
            "evaluation_id",
            "policy_id"
          ],
          "properties": {
            "approval_id": {
              "type": "string",
              "minLength": 1
            },
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evaluation_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "approved",
              "deployed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_id",
              "actor_id",
              "approved_at",
              "artifact_sha256",
              "evaluation_id",
              "policy_id"
            ],
            "properties": {
              "approval_id": {
                "type": "string",
                "minLength": 1
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "evaluation_id": {
                "type": "string",
                "minLength": 1
              },
              "policy_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
