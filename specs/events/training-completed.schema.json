{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aerointel:training-completed:1.0.0",
  "title": "training-completed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "correlation_id",
    "actor_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_type": {
      "const": "training-completed"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "model_id",
        "model_version",
        "artifact_uri",
        "artifact_sha256"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_uri": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
